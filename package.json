{
  "name": "js-logic-library",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Universal JavaScript logic library: pure functions, one source, tests included.",
  "scripts": {
    "build": "node scripts/build-index.js && node scripts/run-tests.js",
    "check": "node scripts/build-index.js --check",
    "copy": "node scripts/copy-module.js",
    "verify": "node scripts/verify-modules.js",
    "test": "node scripts/build-index.js --check && node scripts/verify-modules.js && node --test \"modules/**/*.test.js\"",
    "dev": "npm run build && node scripts/serve.mjs"
  },
  "license": "Apache-2.0"
}
